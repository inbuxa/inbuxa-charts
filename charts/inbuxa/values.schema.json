{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values for the inbuxa chart",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "listenerPort": {
      "description": "A port in the pod, or 0 to leave the listener out.",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicas",
        "role"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "description": "The registry ClusterRole the group's pods run as; empty runs every task.",
          "type": "string"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "^(app\\.kubernetes\\.io|inbuxa\\.org|helm\\.sh)/"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        }
      }
    },
    "groupNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "front",
          "mta",
          "core"
        ]
      }
    },
    "spreadMode": {
      "enum": [
        "DoNotSchedule",
        "ScheduleAnyway",
        "off"
      ]
    },
    "secretMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secretName",
          "items"
        ],
        "properties": {
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "path"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^[^/][^\\0]*$"
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "description": "Kubernetes resources: requests and limits of cpu, memory and ephemeral-storage, as quantities (100m, 256Mi).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei|e[0-9]+)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei|e[0-9]+)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "ephemeral-storage": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei|e[0-9]+)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei|e[0-9]+)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "memory": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei|e[0-9]+)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "ephemeral-storage": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei|e[0-9]+)?$"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "properties": {
    "global": {
      "description": "Set by Helm for charts that have subcharts. Unused here.",
      "type": "object"
    },
    "nameOverride": {
      "description": "Replaces \"inbuxa\" in the names of everything the chart creates.",
      "allOf": [
        {
          "$ref": "#/definitions/name"
        },
        {
          "maxLength": 40
        }
      ]
    },
    "fullnameOverride": {
      "description": "Replaces the whole name: the release name and the chart name.",
      "allOf": [
        {
          "$ref": "#/definitions/name"
        },
        {
          "maxLength": 52
        }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "dataStore": {
          "description": "The data store, written as config.json. Its secrets are File references.",
          "type": "object"
        },
        "secretMounts": {
          "$ref": "#/definitions/secretMounts"
        },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "request": {
              "description": "A JMAP request body: using and methodCalls.",
              "type": "object"
            },
            "existingConfigMap": {
              "type": "string"
            },
            "secretMounts": {
              "$ref": "#/definitions/secretMounts"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 30
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "certificates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "acmeHosts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
              }
            },
            "secrets": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
              }
            },
            "certManager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "issuerRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "Issuer",
                        "ClusterIssuer"
                      ]
                    },
                    "group": {
                      "type": "string"
                    }
                  }
                },
                "dnsNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "renewBefore": {
                  "type": "string"
                }
              }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expectedAddresses": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F.:]+$"
              }
            },
            "checkUrl": {
              "type": "string",
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "upgrade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "acknowledgeLayout": {
              "description": "The store layout version an upgrade may move the store to; 0 for none.",
              "type": "integer",
              "minimum": 0
            },
            "stopServers": {
              "type": "boolean"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^(https://[^/\\s]+)?$"
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "listeners": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "smtp": {
              "description": "25, or 0 for no SMTP. The server's default rules treat only port 25 as mail from the internet, so SMTP can't move.",
              "enum": [
                0,
                25
              ]
            },
            "submissions": {
              "$ref": "#/definitions/listenerPort"
            },
            "imaps": {
              "$ref": "#/definitions/listenerPort"
            },
            "pop3s": {
              "$ref": "#/definitions/listenerPort"
            },
            "sieve": {
              "$ref": "#/definitions/listenerPort"
            },
            "https": {
              "$ref": "#/definitions/listenerPort"
            },
            "http": {
              "description": "Plain HTTP, which the probes use, so it can't be left out.",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "front": {
              "$ref": "#/definitions/group"
            },
            "mta": {
              "$ref": "#/definitions/group"
            },
            "core": {
              "allOf": [
                {
                  "$ref": "#/definitions/group"
                },
                {
                  "properties": {
                    "replicas": {
                      "description": "0 or 1: a second core would queue every maintenance task twice.",
                      "maximum": 1
                    }
                  }
                }
              ]
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "topologySpread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "$ref": "#/definitions/spreadMode"
            },
            "zones": {
              "$ref": "#/definitions/spreadMode"
            }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "http": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ]
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "groups": {
                  "$ref": "#/definitions/groupNames"
                }
              }
            },
            "mail": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "type": {
                  "enum": [
                    "LoadBalancer",
                    "NodePort",
                    "ClusterIP"
                  ]
                },
                "externalTrafficPolicy": {
                  "enum": [
                    "Local",
                    "Cluster"
                  ]
                },
                "loadBalancerClass": {
                  "type": "string"
                },
                "loadBalancerIP": {
                  "type": "string"
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "groups": {
                  "$ref": "#/definitions/groupNames"
                },
                "ports": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "smtp": {
                      "$ref": "#/definitions/port"
                    },
                    "submissions": {
                      "$ref": "#/definitions/port"
                    },
                    "imaps": {
                      "$ref": "#/definitions/port"
                    },
                    "pop3s": {
                      "$ref": "#/definitions/port"
                    },
                    "sieve": {
                      "$ref": "#/definitions/port"
                    }
                  }
                },
                "proxyProtocol": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "trustedNetworks": {
                      "description": "The load balancer's addresses, as it connects to the pods: addresses or networks of /8 or narrower.",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "ports": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "smtp": {
                          "$ref": "#/definitions/listenerPort"
                        },
                        "submissions": {
                          "$ref": "#/definitions/listenerPort"
                        },
                        "imaps": {
                          "$ref": "#/definitions/listenerPort"
                        },
                        "pop3s": {
                          "$ref": "#/definitions/listenerPort"
                        },
                        "sieve": {
                          "$ref": "#/definitions/listenerPort"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prometheus": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "username": {
                  "type": "string",
                  "pattern": "^[^:\\s]+$"
                },
                "existingSecret": {
                  "type": "string"
                },
                "serviceMonitor": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "interval": {
                      "type": "string",
                      "pattern": "^[0-9]+(ms|s|m|h)$"
                    },
                    "labels": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                },
                "rules": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "labels": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "kubeStateMetrics": {
                      "type": "boolean"
                    },
                    "queueMessages": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "queueOldestHours": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "deliveryFailureRatio": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "deliveryFailureMinimum": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "certificateDays": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "storeLatencyMs": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "backupHours": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            },
            "otlp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "endpoint": {
                  "type": "string",
                  "pattern": "^$|^https?://"
                },
                "protocol": {
                  "enum": [
                    "http/protobuf",
                    "grpc"
                  ]
                },
                "intervalSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "headersSecret": {
                  "type": "string"
                }
              }
            },
            "grafanaDashboard": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            },
            "timeZone": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^$|^s3://[^/]+(/.*)?$"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^$|^https?://"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "existingSecret": {
              "type": "string"
            },
            "serviceAccountName": {
              "type": "string"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0
            },
            "successfulJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0
            },
            "failedJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "storeCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quick": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 60
                }
              }
            },
            "full": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 60
                }
              }
            },
            "timeZone": {
              "type": "string"
            },
            "successfulJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0
            },
            "failedJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        }
      }
    },
    "webmail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^(https://[A-Za-z0-9.-]+(:[0-9]+)?/?)?$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "existingSecret": {
          "type": "string"
        },
        "previousAppSecret": {
          "type": "boolean"
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array"
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
